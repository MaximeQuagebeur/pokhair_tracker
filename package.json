{
  "name": "pokhair-tracker",
  "productName": "Pokhair Tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Tracker de poker desktop modulaire (Winamax Cash Game)",
  "author": "Maxime Quagebeur",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "next dev -p 3000",
    "dev": "npm run build:electron && concurrently -k -n web,app \"next dev -p 3000\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:web": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
